#!/usr/bin/env bash
# Sube APP_VERSION de index.html en cada commit que lo incluye (auto-actualización de la PWA, fase 3.1).
# Antes, en TODOS los commits: barrera de tests (harness, ~2 s); si falla, no hay commit (fase 6, 06-02).
# Activar en cada clon:  git config core.hooksPath .githooks   — nunca saltarlo con git commit -n / --no-verify
set -euo pipefail

# Fase 12: datos personales fuera del repo público. Si existe .private-words (gitignored, solo en la máquina del usuario),
# ningún fichero STAGED (añadido/modificado/renombrado) puede contener una de esas palabras; se muestra solo fichero:línea.
# Los ficheros históricos que ya las tenían (forward-only, no se reescriben) están en .githooks/private-words-exempt.
if [ -s .private-words ]; then
  PW=$(mktemp); trap 'rm -f "$PW"' EXIT
  grep -v -x '[[:space:]]*' .private-words > "$PW" || true   # sin líneas vacías (casarían con todo)
  STAGED=()
  while IFS= read -r -d '' f; do                           # -z: rutas con espacios o no-ASCII, sin comillas
    if [ -s .githooks/private-words-exempt ] && grep -q -x -F -- "$f" .githooks/private-words-exempt; then continue; fi
    STAGED+=("$f")
  done < <(git diff --cached --name-only -z --diff-filter=ACMR)
  if [ -s "$PW" ] && [ "${#STAGED[@]}" -gt 0 ]; then
    set +e
    OUT=$(LC_ALL=C.UTF-8 git --literal-pathspecs grep --cached -I -i -n -F -f "$PW" -- "${STAGED[@]}")
    RC=$?
    set -e
    if [ "$RC" -gt 1 ]; then echo "pre-commit: no se ha podido comprobar .private-words (git grep = $RC); commit abortado." >&2; exit 1; fi
    if [ "$RC" -eq 0 ]; then
      echo "pre-commit: hay datos personales (lista de .private-words) en lo que vas a commitear:" >&2
      printf '%s\n' "$OUT" | cut -d: -f1,2 >&2
      exit 1
    fi
  fi
fi

if ! node tests/run-all.mjs >&2; then
  echo "pre-commit: la barrera de tests falla; commit abortado (ver arriba)." >&2
  exit 1
fi
# Los tests leen el árbol de trabajo, no el stage: avisar si tests/ no es lo que se va a commitear
PEND=$(git status --porcelain -- tests/ | grep -v '^[MADRC] ' || true)
if [ -n "$PEND" ]; then
  echo "pre-commit: AVISO — los tests se han ejecutado con cambios en tests/ que no van en este commit:" >&2
  echo "$PEND" >&2
fi

FILE=index.html
git diff --cached --quiet -- "$FILE" && exit 0

# git add metería también lo que no está en el stage → no mezclar cambios
if ! git diff --quiet -- "$FILE"; then
  echo "pre-commit: $FILE tiene cambios sin añadir al commit. Añádelos (git add $FILE) o guárdalos aparte antes de commitear." >&2
  exit 1
fi

VERSION=$(date -u +%Y.%m.%d-%H%M%S)
sed -i -E "s/^const APP_VERSION = '[^']*';$/const APP_VERSION = '$VERSION';/" "$FILE"

if ! grep -qx "const APP_VERSION = '$VERSION';" "$FILE"; then
  echo "pre-commit: no se encontró la línea APP_VERSION en $FILE; commit abortado para no desplegar sin versión." >&2
  exit 1
fi

git add "$FILE"
